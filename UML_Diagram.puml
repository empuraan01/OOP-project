@startuml Smart School Management System

package "com.smartschool.users" {
    abstract class User {
        -String id
        -String name
        -String email
        -String password
        +User(id, name, email)
        +User(id, name, email, password)
        +{abstract} authenticate(String): boolean
        +{abstract} getRole(): String
        +getId(): String
        +getName(): String
        +getEmail(): String
        +setPassword(String): void
    }
    
    class Admin {
        -String department
        -int accessLevel
        +Admin(...)
        +authenticate(String): boolean
        +getRole(): String
        +performRoleDuties(): String
        +getRoleName(): String
        +sendNotification(...): boolean
        +receiveNotification(String): void
    }
    
    class Teacher {
        -String subject
        -String department
        -int yearsOfExperience
        +Teacher(...)
        +authenticate(String): boolean
        +getRole(): String
        +performRoleDuties(): String
        +getRoleName(): String
        +sendNotification(...): boolean
        +receiveNotification(String): void
    }
    
    class Student {
        -String gradeLevel
        -String studentClass
        -double gpa
        +Student(...)
        +authenticate(String): boolean
        +getRole(): String
        +sendNotification(...): boolean
        +receiveNotification(String): void
    }
    
    interface Role {
        +performRoleDuties(): String
        +getRoleName(): String
    }
    
    User <|-- Admin
    User <|-- Teacher
    User <|-- Student
    Role <|.. Admin
    Role <|.. Teacher
}

package "com.smartschool.notifications" {
    interface Notifier {
        +sendNotification(String, String): boolean
        +receiveNotification(String): void
    }
    
    class Message {
        -String senderId
        -String recipientId
        -String content
        -LocalDateTime timestamp
        -boolean isRead
        +Message(...)
        +getSenderId(): String
        +getRecipientId(): String
        +getContent(): String
        +markAsRead(): void
    }
    
    class NoticeBoard {
        -List<Message> messages
        -List<String> announcements
        +sendMessage(...): Message
        +broadcastMessage(String, String...): int
        +broadcastMessage(String, String, String...): int
        +getMessagesFor(String): List<Message>
    }
    
    Notifier <|.. Admin
    Notifier <|.. Teacher
    Notifier <|.. Student
    NoticeBoard *-- Message
}

package "com.smartschool.auth" {
    class LoginSystem {
        -Map<String, User> users
        -User currentUser
        +registerUser(User): void
        +login(String, String): User
        +interactiveLogin(Scanner): User
        +logout(): void
        +isLoggedIn(): boolean
    }
    
    class PasswordUtils {
        +isValidPassword(String): boolean
        +{static} class PasswordHasher {
            +{static} hashPassword(String): String
            +{static} verifyPassword(String, String): boolean
            +{static} generateSalt(): String
        }
    }
    
    LoginSystem --> User
    PasswordUtils ..> PasswordUtils.PasswordHasher
}

package "com.smartschool.management" {
    class GradeManager {
        -Map<String, Map<String, Double>> grades
        -String filePath
        +GradeManager()
        +GradeManager(String)
        +addGrade(String, String, Double, User): void
        +addGrade(String, String, Integer, User): void
        +addMultipleGrades(String, User, String...): void
        +getGrade(String, String): Double
        +getStudentGrades(String): Map<String, Double>
        +calculateGPA(String): Double
        +saveToFile(): void
        +loadFromFile(): void
    }
    
    class AttendanceManager {
        -Map<String, Map<LocalDate, Boolean>> attendance
        -String filePath
        +AttendanceManager()
        +AttendanceManager(String)
        +recordAttendance(String, LocalDate, boolean, User): void
        +getAttendance(String, LocalDate): Boolean
        +getStudentAttendance(String): Map<LocalDate, Boolean>
        +calculateAttendancePercentage(String): Double
        +saveToFile(): void
        +loadFromFile(): void
    }
    
    class ScheduleManager {
        -Map<String, Map<DayOfWeek, LocalTime>> schedules
        +addSchedule(String, DayOfWeek, LocalTime): void
        +getSchedule(String): Map<DayOfWeek, LocalTime>
        +removeSchedule(String, DayOfWeek): void
    }
    
    GradeManager --> User
    AttendanceManager --> User
}

package "com.smartschool.exceptions" {
    class InvalidLoginException {
        +InvalidLoginException()
        +InvalidLoginException(String)
        +InvalidLoginException(String, Throwable)
    }
    
    class UnauthorizedAccessException {
        +UnauthorizedAccessException()
        +UnauthorizedAccessException(String)
        +UnauthorizedAccessException(String, Throwable)
    }
}

package "com.smartschool" {
    class Main {
        -static LoginSystem loginSystem
        -static GradeManager gradeManager
        -static AttendanceManager attendanceManager
        -static ScheduleManager scheduleManager
        -static NoticeBoard noticeBoard
        -static Scanner scanner
        +{static} main(String[]): void
    }
    
    Main --> LoginSystem
    Main --> GradeManager
    Main --> AttendanceManager
    Main --> ScheduleManager
    Main --> NoticeBoard
}

LoginSystem ..> InvalidLoginException
GradeManager ..> UnauthorizedAccessException
AttendanceManager ..> UnauthorizedAccessException

note right of User
  Abstract class with
  constructor overloading
end note

note right of PasswordUtils.PasswordHasher
  Static nested class
  for password hashing
end note

note right of GradeManager
  Method overloading:
  - addGrade with Double
  - addGrade with Integer
  Constructor overloading
  Varargs: addMultipleGrades
end note

note right of NoticeBoard
  Varargs overloading:
  - broadcastMessage(String, String...)
  - broadcastMessage(String, String, String...)
end note

@enduml

